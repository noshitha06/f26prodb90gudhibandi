extends layout

block content
  h1= title
  div(class="container-fluid")
    div(class="row")
      each volcano, index in results
        div(class="col-sm-2", onclick=`buy(${index})`)
          p Name: #{volcano.volcano_name}
          p Type: #{volcano.volcano_type}
          p Height: #{volcano.height_m} m
  script.
    function buy(index) {
      alert(`You purchased item ${index}`)
    }