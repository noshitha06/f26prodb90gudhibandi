extends layout

block content
  h1= title
  -
    let results = [
      { name: 'Mount Fuji', country: 'Japan', height_meters: 3776 },
      { name: 'Mauna Loa', country: 'United States', height_meters: 4169 },
      { name: 'Mount Vesuvius', country: 'Italy', height_meters: 1281 },
      { name: 'Mount St. Helens', country: 'United States', height_meters: 2549 }
    ]
  div(class="container-fluid")
    div(class="row")
      each volcano, index in results
        div(class="col-sm-2", onclick=`buy(${index})`)
        div(class="container-fluid")
        div(class="row")
      each volcano, index in results
        div(class="col-sm-2", onclick=`buy(${index})`)
          p Name: #{volcano.name}
          p Country: #{volcano.country}
          p Height: #{volcano.height_meters} m
  script.
   function buy(index) {
      alert(`You purchased item ${index}`)
    }